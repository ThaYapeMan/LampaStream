diff --git a/early_tap.c b/early_tap.c
new file mode 100644
index 00000000..1f51cc38
--- /dev/null
+++ b/early_tap.c
@@ -0,0 +1,119 @@
+/* Timestamped S16_LE stereo copy, bounded atomic non-blocking FIFO writes.
+ * Wire v1: 52-byte little-endian header, followed by frames * 4 bytes.
+ * The regular output backend and its timing are deliberately untouched.
+ */
+#include "early_tap.h"
+#include "rtp.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <string.h>
+#include <time.h>
+#include <sys/stat.h>
+#include <unistd.h>
+static pthread_mutex_t tap_lock = PTHREAD_MUTEX_INITIALIZER;
+static atomic_uint generation = 1;
+static atomic_ullong drops;
+static atomic_int paused;
+static int fd = -1, connection = -1, have_expected;
+static uint32_t expected;
+static uint64_t last_log, last_play;
+static uint32_t last_frames;
+static void le(unsigned char *p, uint64_t value, int bytes) {
+  for (int i = 0; i < bytes; ++i) p[i] = value >> (8 * i);
+}
+void early_tap(rtsp_conn_info *conn, const void *pcm, uint32_t frames,
+               uint32_t rtp, uint16_t flags) {
+  if (!config.early_tap_pipe) return;
+  if (flags & (TAP_FLUSH | TAP_PAUSE | TAP_RESUME | TAP_DISCONTINUITY))
+    atomic_fetch_add(&generation, 1);
+  if (flags & TAP_PAUSE) atomic_store(&paused, 1);
+  if (flags & TAP_RESUME) atomic_store(&paused, 0);
+  uint32_t record_generation = atomic_load(&generation);
+  if (pthread_mutex_trylock(&tap_lock) != 0) {
+    atomic_fetch_add(&drops, 1);
+    atomic_fetch_add(&generation, 1);
+    return;
+  }
+  if (connection != conn->connection_number) {
+    connection = conn->connection_number;
+    have_expected = 0;
+    atomic_store(&paused, 0);
+    atomic_fetch_add(&generation, 1);
+    flags |= TAP_DISCONTINUITY;
+    record_generation = atomic_load(&generation);
+  }
+  if (flags & (TAP_FLUSH | TAP_PAUSE | TAP_RESUME | TAP_DISCONTINUITY))
+    have_expected = 0;
+  if (frames && atomic_load(&paused)) goto done;
+  if (frames && (conn->input_rate != 44100 || conn->input_bit_depth != 16 ||
+                 conn->input_bytes_per_frame != 4)) goto drop;
+  uint64_t play = 0;
+  if (frames && frame_to_local_time(rtp, &play, conn) != 0) goto drop;
+  if (frames && have_expected) {
+    int32_t distance = (int32_t)(rtp - expected);
+    if (distance < 0) flags |= TAP_OUT_OF_ORDER;
+    else if (distance > 0) {
+      flags |= TAP_DISCONTINUITY;
+      record_generation = atomic_fetch_add(&generation, 1) + 1;
+    } else {
+      int64_t shift = play - (last_play + (uint64_t)last_frames * 1000000000 / 44100);
+      if (shift > 50000000 || shift < -50000000) {
+        flags |= TAP_DISCONTINUITY;
+        record_generation = atomic_fetch_add(&generation, 1) + 1;
+      }
+    }
+  }
+  if (frames && !(flags & TAP_OUT_OF_ORDER)) {
+    expected = rtp + frames;
+    last_play = play; last_frames = frames;
+    have_expected = 1;
+  }
+  if (fd < 0) fd = open(config.early_tap_pipe, O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+  if (fd < 0) goto drop;
+  struct stat status;
+  if (fstat(fd, &status) != 0 || !S_ISFIFO(status.st_mode)) {
+    close(fd); fd = -1; goto drop;
+  }
+  uint32_t offset = 0;
+  do {
+    uint32_t count = frames - offset;
+    if (count > 1000) count = 1000;
+    unsigned char record[4052]; /* below Linux PIPE_BUF=4096, all-or-nothing */
+    struct timespec mono;
+    uint64_t raw = get_absolute_time_in_ns();
+    clock_gettime(CLOCK_MONOTONIC, &mono); /* paired, not an assumed clock offset */
+    uint64_t monotonic = (uint64_t)mono.tv_sec * 1000000000 + mono.tv_nsec;
+    memcpy(record, "LSET", 4);
+    le(record + 4, 1, 2); le(record + 6, flags, 2);
+    le(record + 8, rtp + offset, 4); le(record + 12, count, 4);
+    le(record + 16, record_generation, 4);
+    le(record + 20, play + (uint64_t)offset * 1000000000 / 44100, 8);
+    le(record + 28, raw, 8); le(record + 36, monotonic, 8);
+    le(record + 44, atomic_load(&drops), 8);
+    /* Integer samples are host-native; serialise explicitly as S16_LE. */
+    for (uint32_t i = 0; i < count * 2; ++i) {
+      uint16_t sample;
+      memcpy(&sample, (const unsigned char *)pcm + offset * 4 + i * 2, 2);
+      le(record + 52 + i * 2, sample, 2);
+    }
+    if (write(fd, record, 52 + count * 4) != (ssize_t)(52 + count * 4)) {
+      if (errno == EPIPE || errno == EBADF) { close(fd); fd = -1; }
+      goto drop;
+    }
+    offset += count;
+    flags &= ~TAP_DISCONTINUITY;
+  } while (offset < frames);
+  goto done;
+drop:
+  atomic_fetch_add(&drops, 1);
+  atomic_fetch_add(&generation, 1); /* even a lost marker is visible next time */
+done:;
+  uint64_t now = get_absolute_time_in_ns();
+  if (now - last_log >= 30000000000ULL) {
+    last_log = now;
+    inform("LampaStream early tap: dropped records=%llu", (unsigned long long)atomic_load(&drops));
+  }
+  pthread_mutex_unlock(&tap_lock);
+}
diff --git a/early_tap.h b/early_tap.h
new file mode 100644
index 00000000..3855365c
--- /dev/null
+++ b/early_tap.h
@@ -0,0 +1,12 @@
+/* LampaStream observational tap: never changes receiver playout. */
+#ifndef EARLY_TAP_H
+#define EARLY_TAP_H
+#include "common.h"
+#define TAP_FLUSH 1
+#define TAP_PAUSE 2
+#define TAP_RESUME 4
+#define TAP_DISCONTINUITY 8
+#define TAP_OUT_OF_ORDER 16
+void early_tap(rtsp_conn_info *conn, const void *pcm, uint32_t frames,
+               uint32_t rtp, uint16_t flags);
+#endif
